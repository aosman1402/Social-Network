# Path to the SQLite database file.
# Default (if unset): <backend>/pkg/db/sqlite/social-network.db
DB_PATH=

# Path to the directory containing up/down migration files.
# Default (if unset): <backend>/pkg/db/migrations/sqlite
MIGRATIONS_PATH=

# Port the HTTP server listens on.
# Default (if unset): 8081
PORT=8081

# --- Login with GitHub (optional) ------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8081/api/auth/github/callback
# then copy this file to backend/.env (gitignored) and fill these in.
# Left empty, the "Continue with GitHub" button shows as unavailable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only needed if the backend / frontend aren't on the default localhost ports.
# BACKEND_URL=http://localhost:8081
# FRONTEND_URL=http://localhost:3000
