# Settings for `docker-compose up` - copy to .env (gitignored) next to
# docker-compose.yml. Running the backend without Docker? Use backend/.env instead.

# Login with GitHub (optional). Create an OAuth App at
# https://github.com/settings/developers with
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8081/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
