# Backend origin used by next.config.js to proxy /api/* requests at build time.
# This is baked into the build (rewrites() is frozen into the build output),
# so it must be set before `next build`, not read at request time.
# Default (if unset): http://localhost:8081
# In docker-compose, this is set as a build arg to http://backend:8081.
BACKEND_INTERNAL_URL=http://localhost:8081
